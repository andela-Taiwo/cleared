# Copy to .env and fill in. Never commit .env.

# dev | test | prod
CLEARED_ENVIRONMENT=dev

# Runtime connection. Uses the non-superuser app role, which is subject to RLS.
CLEARED_DATABASE_URL=postgresql+asyncpg://cleared_app:cleared_app@127.0.0.1:5432/cleared_dev

# Migrations run as the owner role, which is allowed to change the schema.
CLEARED_MIGRATION_DATABASE_URL=postgresql+asyncpg://cleared_owner:cleared_owner@127.0.0.1:5432/cleared_dev

# 32+ bytes of randomness: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
CLEARED_SECRET_KEY=dev-only-not-a-real-secret-dev-only-not-a-real-secret

# Where uploaded credential documents are stored.
CLEARED_UPLOAD_DIR=./var/uploads

# Used by the reminder job's HTTP endpoint. Empty disables the endpoint.
CLEARED_SCHEDULER_TOKEN=
